# Public Preview + Excel mode needs NO API key. Windows uses installed Edge by default.
# chromium / msedge / chrome; install Chromium with: npx playwright install chromium
SCOPUS_BROWSER_CHANNEL=
SCOPUS_HEADLESS=true
# Keep enabled on normal hosts. The provided isolated Docker image sets false.
SCOPUS_BROWSER_SANDBOX=true
# stdio/CLI export directory; local files persist until you delete them.
SCOPUS_EXPORT_DIR=exports
# Optional API tools only. A key does NOT guarantee Elsevier entitlement.
ELSEVIER_API_KEY=
# Optional institutional token issued by Elsevier for authorized remote access.
ELSEVIER_INST_TOKEN=
# HTTP defaults to local-only. Remote hosting also requires PUBLIC_URL and a strong MCP_TOKEN.
HOST=127.0.0.1
PORT=8790
MCP_TOKEN=
PUBLIC_URL=
