{
  "name": "scopus-profiles-mcp",
  "version": "0.2.0",
  "description": "Scopus public Preview to Excel without API keys, plus optional authorized profile APIs",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hhhkarimi/Hossein-Karimi-AI-Library.git",
    "directory": "mcp/scopus-mcp"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs",
    "check": "npm test",
    "verify:live": "node scripts/verify-live.mjs",
    "export:author": "node dist/export-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "exceljs": "^4.4.0",
    "playwright": "^1.64.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
