{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"], "strict": true, "noUncheckedIndexedAccess": true, "noEmitOnError": true,
    "esModuleInterop": true, "skipLibCheck": true, "rootDir": "src", "outDir": "dist", "declaration": true, "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
